# Copy to .env and fill in. Never commit .env.
PG_PASSWORD=change-me
# Vault env references in config/ai.yaml resolve to these (prefix AIGW_)
AIGW_OPENAI_AUTH_HEADER=Bearer sk-REPLACE
# Consumer API keys, substituted into config/ai.yaml by sync.sh
KEY_LOAN_OFFICER_APP=REPLACE
KEY_AGENT_PREVERIFICATION=REPLACE
KEY_AGENT_CREDIT_INCOME=REPLACE
KEY_AGENT_RISK_RATING=REPLACE
KEY_AGENT_STIPULATIONS=REPLACE
KEY_AGENT_FINAL_APPROVAL=REPLACE
KEY_AGENT_INTAKE_HEADLESS=REPLACE
